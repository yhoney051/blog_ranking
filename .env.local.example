# Supabase 설정 (https://supabase.com 에서 프로젝트 생성 후 복사)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Bright Data SERP API (https://brightdata.com 에서 발급)
BRIGHTDATA_API_KEY=your_brightdata_api_key

# Vercel Cron 인증
CRON_SECRET=your_cron_secret

# Sentry (https://sentry.io 에서 프로젝트 생성 후 복사)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Channel.io (https://channel.io 에서 발급, 선택사항)
NEXT_PUBLIC_CHANNEL_IO_KEY=your_channel_io_plugin_key

# 포트원 V2 (https://admin.portone.io 에서 발급)
NEXT_PUBLIC_PORTONE_STORE_ID=your_store_id
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=your_channel_key
PORTONE_API_SECRET=your_api_secret
PORTONE_WEBHOOK_SECRET=your_webhook_secret
